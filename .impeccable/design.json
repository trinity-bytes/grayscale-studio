  "narrative": {
    "northStar": "Dark workbench",
    "overview": "A compact, exclusively dark image workbench: original and processed images lead, their distributions sit directly beneath them, and a persistent calculation rail exposes the actual CDF/LUT mapping. The interface is a working tool, not a tutorial or a course.\n\nNeutral lightness steps establish hierarchy; blue marks processed data and inspection feedback rather than filling navigation. UI labels use local Poppins, while numerical columns and expressions use local IBM Plex Mono. Existing processing and numerical semantics remain outside the visual redesign.",
    "keyCharacteristics": [
      "Paired images with directly associated frequency panels.",
      "A persistent, data-driven calculation inspector.",
      "Neutral primary actions and blue processed data.",
      "Opaque, flat surfaces and local typography."
    ],
    "rules": [
      {
        "name": "Data Color",
        "body": "Use blue for processed values and inspection feedback; keep persistent navigation and surfaces neutral.",
        "section": "colors"
      },
      {
        "name": "Measured Numbers",
        "body": "Use IBM Plex Mono for numeric columns, measurements and expressions, and Poppins for interface language.",
        "section": "typography"
      },
      {
        "name": "Flat Surfaces",
        "body": "Separate resting regions through lightness and quiet rules, not decorative shadows or glass.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the original project logo and symbol assets.",
      "Do render image, histogram, CDF and LUT values from runtime data.",
      "Do keep original and result histogram scales identical within a comparison.",
      "Do show zero counts as zero and unavailable measurements as an em dash.",
      "Do retain keyboard inspection, explicit processing actions and recoverable errors."
    ],
    "donts": [
      "Don't introduce a light-theme toggle, glass surfaces or a tutorial stepper.",
      "Don't smooth frequency or cumulative data into invented intermediate values.",
      "Don't replace the original mark with a reconstructed or generated logo.",
      "Don't claim screenshots establish accessibility certification or physical-device behavior."
    ]
  }
